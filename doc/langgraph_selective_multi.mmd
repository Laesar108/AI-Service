---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route(route)
	target(target)
	chat_answer(chat_answer)
	plan(plan)
	research(research)
	analysis(analysis)
	write(write)
	validate(validate)
	fallback(fallback)
	finalize(finalize)
	select_research(select_research)
	metrics_researcher(metrics_researcher)
	logs_researcher(logs_researcher)
	runbook_pipeline(runbook_pipeline)
	supervisor_join(supervisor_join)
	__end__([<p>__end__</p>]):::last
	__start__ --> route;
	analysis --> write;
	fallback --> finalize;
	logs_researcher --> supervisor_join;
	metrics_researcher --> supervisor_join;
	plan --> research;
	research --> select_research;
	route -.-> chat_answer;
	route -.-> target;
	runbook_pipeline --> supervisor_join;
	select_research --> logs_researcher;
	select_research --> metrics_researcher;
	select_research --> runbook_pipeline;
	supervisor_join --> analysis;
	target -. &nbsp;stop&nbsp; .-> __end__;
	target -.-> plan;
	validate -.-> fallback;
	validate -.-> finalize;
	validate -.-> write;
	write --> validate;
	chat_answer --> __end__;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
